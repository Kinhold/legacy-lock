{
  "name": "@kinhold/legacy-lock",
  "version": "1.0.0",
  "private": false,
  "description": "Legacy Lock — zero-knowledge inheritance vault (seal, time-lock, heir claim, receipts)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "legacy-lock": "./bin/legacy-lock.mjs"
  },
  "files": [
    "dist",
    "bin",
    "circuits",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:stress": "node --import tsx --test test/stress.test.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:stress"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
